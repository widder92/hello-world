# ---------------------------------------------------------------------------
# Ticketsystem – Konfiguration
# Diese Datei nach .env kopieren und ausfüllen. .env gehört NICHT ins Git.
# ---------------------------------------------------------------------------

# Datenbank ------------------------------------------------------------------
DATABASE_URL="postgresql://ticket:ticket@localhost:5432/ticketsystem?schema=public"

# Grundeinstellungen ---------------------------------------------------------
# Öffentliche Adresse der Anwendung (für Links in E-Mails)
APP_URL="http://localhost:3000"
APP_NAME="Ticketsystem"

# Zufälliger Schlüssel. Erzeugen mit:  openssl rand -base64 48
# Wird für Sitzungen UND für die Verschlüsselung der Postfach-Zugangsdaten
# sowie für die Signatur der E-Mail-Antwortadressen verwendet.
# Zum Ausprobieren auf dem eigenen Rechner können diese beiden Werte so
# stehen bleiben. Für den echten Betrieb MÜSSEN sie ersetzt werden – sie
# stehen öffentlich in diesem Repository und sind damit kein Geheimnis.
#
# Beide bewusst ausgeschrieben und nicht der eine als Verweis auf den anderen:
# Docker Compose löst ${...} in einer env_file nicht auf, dort käme sonst
# wörtlich der Verweis an.
APP_SECRET="nur-zum-ausprobieren-nicht-fuer-den-echten-betrieb-1234567890"
AUTH_SECRET="nur-zum-ausprobieren-nicht-fuer-den-echten-betrieb-0987654321"
AUTH_TRUST_HOST="true"

# Anmeldung: Microsoft Entra ID (optional) -----------------------------------
# Leer lassen, wenn nur lokale Konten genutzt werden. Die Anmeldeseite blendet
# die SSO-Schaltfläche dann automatisch aus.
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
# Beispiel-Issuer: https://login.microsoftonline.com/<tenant-id>/v2.0

# Anmeldung: lokale Konten ---------------------------------------------------
# Auf "false" setzen, wenn ausschließlich SSO erlaubt sein soll.
LOCAL_LOGIN_ENABLED="true"

# E-Mail-Versand -------------------------------------------------------------
# Transport: smtp | graph | none  ("none" = Versand nur protokollieren, für Tests)
MAIL_TRANSPORT="smtp"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="Ticketsystem"
MAIL_FROM_ADDRESS="ticketsystem@example.org"

# Basis für signierte Antwortadressen. Der Mailserver muss alle Adressen der
# Form  ticket+<token>@<domain>  an das Systempostfach zustellen (Catch-all
# oder Plus-Adressierung). Ohne diese Adresse funktioniert die Bearbeitung
# per E-Mail-Antwort nicht.
MAIL_REPLY_DOMAIN="example.org"
MAIL_REPLY_LOCALPART="ticket"

# Microsoft Graph für Mailabruf/-versand (optional) --------------------------
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# Worker ---------------------------------------------------------------------
# Wie oft die Postfächer abgefragt werden (Cron-Ausdruck)
WORKER_MAIL_CRON="*/2 * * * *"
# Wie oft SLA-Fristen geprüft werden
WORKER_SLA_CRON="*/5 * * * *"
# Aufräumjob (Löschfristen) – täglich nachts
WORKER_CLEANUP_CRON="30 3 * * *"
# Geschlossene Tickets nach X Tagen löschen. 0 = nie löschen.
RETENTION_DAYS="0"

# Dateiablage ----------------------------------------------------------------
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="25"

# Zeitzone für Dienstzeiten und Fristen
TZ="Europe/Berlin"
